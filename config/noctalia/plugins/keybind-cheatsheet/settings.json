{
  "cheatsheetData": [
    {
      "title": "APPS",
      "binds": [
        {
          "keys": "RETURN",
          "desc": "Terminal",
          "_verb": "exec",
          "_param": "$terminal",
          "_mods": "",
          "_mainKey": "RETURN"
        },
        {
          "keys": "X",
          "desc": "Terminal",
          "_verb": "exec",
          "_param": "$terminal",
          "_mods": "",
          "_mainKey": "X"
        },
        {
          "keys": "Shift + E",
          "desc": "File manager",
          "_verb": "exec",
          "_param": "$fileManager",
          "_mods": "Shift",
          "_mainKey": "E"
        },
        {
          "keys": "D",
          "desc": "App launcher",
          "_verb": "exec",
          "_param": "$menu",
          "_mods": "",
          "_mainKey": "D"
        },
        {
          "keys": "W",
          "desc": "Window switcher",
          "_verb": "exec",
          "_param": "$ipc launcher windows",
          "_mods": "",
          "_mainKey": "W"
        },
        {
          "keys": "PERIOD",
          "desc": "Emoji picker",
          "_verb": "exec",
          "_param": "$ipc launcher emoji",
          "_mods": "",
          "_mainKey": "PERIOD"
        },
        {
          "keys": "U",
          "desc": "Unicode picker",
          "_verb": "exec",
          "_param": "$ipc plugin:unicode toggle",
          "_mods": "",
          "_mainKey": "U"
        },
        {
          "keys": "ESCAPE",
          "desc": "Lock screen",
          "_verb": "exec",
          "_param": "$ipc lockScreen lock",
          "_mods": "",
          "_mainKey": "ESCAPE"
        }
      ]
    },
    {
      "title": "PANELS",
      "binds": [
        {
          "keys": "C",
          "desc": "Control center",
          "_verb": "exec",
          "_param": "$ipc controlCenter toggle",
          "_mods": "",
          "_mainKey": "C"
        },
        {
          "keys": "N",
          "desc": "Network panel",
          "_verb": "exec",
          "_param": "$ipc network togglePanel",
          "_mods": "",
          "_mainKey": "N"
        },
        {
          "keys": "B",
          "desc": "Bluetooth panel",
          "_verb": "exec",
          "_param": "$ipc bluetooth togglePanel",
          "_mods": "",
          "_mainKey": "B"
        },
        {
          "keys": "Shift + B",
          "desc": "Battery panel",
          "_verb": "exec",
          "_param": "$ipc battery togglePanel",
          "_mods": "Shift",
          "_mainKey": "B"
        },
        {
          "keys": "COMMA",
          "desc": "Noctalia settings",
          "_verb": "exec",
          "_param": "$ipc settings toggle",
          "_mods": "",
          "_mainKey": "COMMA"
        },
        {
          "keys": "O",
          "desc": "System monitor",
          "_verb": "exec",
          "_param": "$ipc systemMonitor toggle",
          "_mods": "",
          "_mainKey": "O"
        },
        {
          "keys": "MINUS",
          "desc": "Notification history",
          "_verb": "exec",
          "_param": "$ipc notifications toggleHistory",
          "_mods": "",
          "_mainKey": "MINUS"
        },
        {
          "keys": "Shift + D",
          "desc": "Toggle dark/light mode (apps)",
          "_verb": "exec",
          "_param": "darkmode-toggle && notify-send \"toggling dark/light mode\"",
          "_mods": "Shift",
          "_mainKey": "D"
        },
        {
          "keys": "XF86LAUNCH3",
          "desc": "Toggle dark/light mode (shell)",
          "_verb": "exec",
          "_param": "$ipc darkMode toggle",
          "_mods": "",
          "_mainKey": "XF86LAUNCH3"
        }
      ]
    },
    {
      "title": "WINDOWS",
      "binds": [
        {
          "keys": "Shift + Q",
          "desc": "Close window",
          "_verb": "killactive",
          "_param": "",
          "_mods": "Shift",
          "_mainKey": "Q"
        },
        {
          "keys": "F",
          "desc": "Toggle floating",
          "_verb": "togglefloating",
          "_param": "",
          "_mods": "",
          "_mainKey": "F"
        },
        {
          "keys": "P",
          "desc": "Pin window (sticky on all workspaces)",
          "_verb": "exec",
          "_param": "hyprctl --batch \"dispatch setfloating; dispatch pin\"",
          "_mods": "",
          "_mainKey": "P"
        },
        {
          "keys": "Z",
          "desc": "Toggle maximize",
          "_verb": "fullscreen",
          "_param": "1",
          "_mods": "",
          "_mainKey": "Z"
        },
        {
          "keys": "R",
          "desc": "Toggle split direction",
          "_verb": "layoutmsg",
          "_param": "togglesplit",
          "_mods": "",
          "_mainKey": "R"
        },
        {
          "keys": "Shift + R",
          "desc": "Rebalance window sizes",
          "_verb": "exec",
          "_param": "/etc/nixos/config/hyprland/rebalance.sh",
          "_mods": "Shift",
          "_mainKey": "R"
        }
      ]
    },
    {
      "title": "OVERVIEW",
      "binds": [
        {
          "keys": "SPACE",
          "desc": "Toggle overview",
          "_verb": "gloview:toggle",
          "_param": "",
          "_mods": "",
          "_mainKey": "SPACE"
        },
        {
          "keys": "BRACKETRIGHT",
          "desc": "Overview: next workspace",
          "_verb": "gloview:next",
          "_param": "",
          "_mods": "",
          "_mainKey": "BRACKETRIGHT"
        },
        {
          "keys": "BRACKETLEFT",
          "desc": "Overview: previous workspace",
          "_verb": "gloview:prev",
          "_param": "",
          "_mods": "",
          "_mainKey": "BRACKETLEFT"
        },
        {
          "keys": "1-9",
          "desc": "Overview: go to workspace 1-9",
          "_verb": "gloview:setworkspace",
          "_mods": "",
          "_mainKey": "1-9",
          "_merged": true
        }
      ]
    },
    {
      "title": "TOOLS",
      "binds": [
        {
          "keys": "S",
          "desc": "Jump to window (easymotion)",
          "_verb": "easymotion",
          "_param": "action:hyprctl dispatch focuswindow address:{}",
          "_mods": "",
          "_mainKey": "S"
        },
        {
          "keys": "Shift + S",
          "desc": "Screenshot area (then edit/OCR/copy)",
          "_verb": "exec",
          "_param": "/etc/nixos/config/hyprland/screenshot.sh ask",
          "_mods": "Shift",
          "_mainKey": "S"
        },
        {
          "keys": "Shift + Alt + S",
          "desc": "Screenshot area to text (OCR)",
          "_verb": "exec",
          "_param": "/etc/nixos/config/hyprland/screenshot.sh ocr",
          "_mods": "Shift+Alt",
          "_mainKey": "S"
        },
        {
          "keys": "V",
          "desc": "Clipboard history",
          "_verb": "exec",
          "_param": "$clipboardHistory",
          "_mods": "",
          "_mainKey": "V"
        }
      ]
    },
    {
      "title": "SCREENSHOT PROMPT (WHILE ITS NOTIFICATION IS SHOWN)",
      "binds": [
        {
          "keys": "E",
          "desc": "Edit in swappy",
          "_verb": "exec",
          "_param": "$screenshotAction edit",
          "_mods": "",
          "_mainKey": "E"
        },
        {
          "keys": "RETURN",
          "desc": "Edit in swappy",
          "_verb": "exec",
          "_param": "$screenshotAction edit",
          "_mods": "",
          "_mainKey": "RETURN"
        },
        {
          "keys": "O",
          "desc": "OCR text to clipboard",
          "_verb": "exec",
          "_param": "$screenshotAction ocr",
          "_mods": "",
          "_mainKey": "O"
        },
        {
          "keys": "C",
          "desc": "Copy image to clipboard",
          "_verb": "exec",
          "_param": "$screenshotAction copy",
          "_mods": "",
          "_mainKey": "C"
        },
        {
          "keys": "ESCAPE",
          "desc": "Copy image to clipboard",
          "_verb": "exec",
          "_param": "$screenshotAction copy",
          "_mods": "",
          "_mainKey": "ESCAPE"
        }
      ]
    },
    {
      "title": "CHEATSHEET",
      "binds": [
        {
          "keys": "SUPER_L",
          "desc": "Hold: show this cheatsheet",
          "_verb": "exec",
          "_param": "touch $keyhintFlag && $ipc plugin:keybind-cheatsheet toggle",
          "_mods": "",
          "_mainKey": "SUPER_L"
        },
        {
          "keys": "Super + SUPER_L",
          "desc": "Release: close cheatsheet",
          "_verb": "exec",
          "_param": "rm $keyhintFlag && $ipc plugin:keybind-cheatsheet toggle",
          "_mods": "Super",
          "_mainKey": "SUPER_L"
        }
      ]
    },
    {
      "title": "FOCUS, MOVE & RESIZE",
      "binds": [
        {
          "keys": "LEFT",
          "desc": "Focus left",
          "_verb": "movefocus",
          "_param": "l",
          "_mods": "",
          "_mainKey": "LEFT"
        },
        {
          "keys": "RIGHT",
          "desc": "Focus right",
          "_verb": "movefocus",
          "_param": "r",
          "_mods": "",
          "_mainKey": "RIGHT"
        },
        {
          "keys": "UP",
          "desc": "Focus up",
          "_verb": "movefocus",
          "_param": "u",
          "_mods": "",
          "_mainKey": "UP"
        },
        {
          "keys": "DOWN",
          "desc": "Focus down",
          "_verb": "movefocus",
          "_param": "d",
          "_mods": "",
          "_mainKey": "DOWN"
        },
        {
          "keys": "H",
          "desc": "Focus left",
          "_verb": "movefocus",
          "_param": "l",
          "_mods": "",
          "_mainKey": "H"
        },
        {
          "keys": "L",
          "desc": "Focus right",
          "_verb": "movefocus",
          "_param": "r",
          "_mods": "",
          "_mainKey": "L"
        },
        {
          "keys": "K",
          "desc": "Focus up",
          "_verb": "movefocus",
          "_param": "u",
          "_mods": "",
          "_mainKey": "K"
        },
        {
          "keys": "J",
          "desc": "Focus down",
          "_verb": "movefocus",
          "_param": "d",
          "_mods": "",
          "_mainKey": "J"
        },
        {
          "keys": "Shift + H",
          "desc": "Move window left",
          "_verb": "movewindow",
          "_param": "l",
          "_mods": "Shift",
          "_mainKey": "H"
        },
        {
          "keys": "Shift + L",
          "desc": "Move window right",
          "_verb": "movewindow",
          "_param": "r",
          "_mods": "Shift",
          "_mainKey": "L"
        },
        {
          "keys": "Shift + K",
          "desc": "Move window up",
          "_verb": "movewindow",
          "_param": "u",
          "_mods": "Shift",
          "_mainKey": "K"
        },
        {
          "keys": "Shift + J",
          "desc": "Move window down",
          "_verb": "movewindow",
          "_param": "d",
          "_mods": "Shift",
          "_mainKey": "J"
        },
        {
          "keys": "Ctrl + H",
          "desc": "Shrink width",
          "_verb": "resizeactive",
          "_param": "-50 0",
          "_mods": "Ctrl",
          "_mainKey": "H"
        },
        {
          "keys": "Ctrl + L",
          "desc": "Grow width",
          "_verb": "resizeactive",
          "_param": "50 0",
          "_mods": "Ctrl",
          "_mainKey": "L"
        },
        {
          "keys": "Ctrl + K",
          "desc": "Shrink height",
          "_verb": "resizeactive",
          "_param": "0 -50",
          "_mods": "Ctrl",
          "_mainKey": "K"
        },
        {
          "keys": "Ctrl + J",
          "desc": "Grow height",
          "_verb": "resizeactive",
          "_param": "0 50",
          "_mods": "Ctrl",
          "_mainKey": "J"
        }
      ]
    },
    {
      "title": "WORKSPACES",
      "binds": [
        {
          "keys": "1-9",
          "desc": "Go to workspace 1-9",
          "_verb": "workspace",
          "_mods": "",
          "_mainKey": "1-9",
          "_merged": true
        },
        {
          "keys": "0",
          "desc": "Go to workspace 10",
          "_verb": "workspace",
          "_param": "10",
          "_mods": "",
          "_mainKey": "0"
        },
        {
          "keys": "Shift + 1-9",
          "desc": "Send window to workspace 1-9",
          "_verb": "movetoworkspacesilent",
          "_mods": "Shift",
          "_mainKey": "1-9",
          "_merged": true
        },
        {
          "keys": "Shift + 0",
          "desc": "Send window to workspace 10",
          "_verb": "movetoworkspacesilent",
          "_param": "10",
          "_mods": "Shift",
          "_mainKey": "0"
        },
        {
          "keys": "M",
          "desc": "Toggle scratchpad",
          "_verb": "togglespecialworkspace",
          "_param": "magic",
          "_mods": "",
          "_mainKey": "M"
        },
        {
          "keys": "Shift + M",
          "desc": "Send window to scratchpad",
          "_verb": "movetoworkspace",
          "_param": "special:magic",
          "_mods": "Shift",
          "_mainKey": "M"
        },
        {
          "keys": "Scroll Down",
          "desc": "Next workspace",
          "_verb": "workspace",
          "_param": "e+1",
          "_mods": "",
          "_mainKey": "MOUSE_DOWN"
        },
        {
          "keys": "Scroll Up",
          "desc": "Previous workspace",
          "_verb": "workspace",
          "_param": "e-1",
          "_mods": "",
          "_mainKey": "MOUSE_UP"
        }
      ]
    },
    {
      "title": "MOUSE",
      "binds": [
        {
          "keys": "Left Click",
          "desc": "Drag to move window",
          "_verb": "movewindow",
          "_param": "",
          "_mods": "",
          "_mainKey": "MOUSE:272"
        },
        {
          "keys": "Right Click",
          "desc": "Drag to resize window",
          "_verb": "resizewindow",
          "_param": "",
          "_mods": "",
          "_mainKey": "MOUSE:273"
        }
      ]
    },
    {
      "title": "HARDWARE KEYS",
      "binds": [
        {
          "keys": "Vol Up",
          "desc": "Volume up",
          "_verb": "exec",
          "_param": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
          "_mods": "",
          "_mainKey": "XF86AUDIORAISEVOLUME"
        },
        {
          "keys": "Vol Down",
          "desc": "Volume down",
          "_verb": "exec",
          "_param": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
          "_mods": "",
          "_mainKey": "XF86AUDIOLOWERVOLUME"
        },
        {
          "keys": "Mute",
          "desc": "Mute audio",
          "_verb": "exec",
          "_param": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "_mods": "",
          "_mainKey": "XF86AUDIOMUTE"
        },
        {
          "keys": "Mic Mute",
          "desc": "Mute microphone",
          "_verb": "exec",
          "_param": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
          "_mods": "",
          "_mainKey": "XF86AUDIOMICMUTE"
        },
        {
          "keys": "Bright Up",
          "desc": "Screen brightness up",
          "_verb": "exec",
          "_param": "brightnessctl set 5%+",
          "_mods": "",
          "_mainKey": "XF86MONBRIGHTNESSUP"
        },
        {
          "keys": "Bright Down",
          "desc": "Screen brightness down",
          "_verb": "exec",
          "_param": "brightnessctl set 5%-",
          "_mods": "",
          "_mainKey": "XF86MONBRIGHTNESSDOWN"
        },
        {
          "keys": "XF86KBDBRIGHTNESSUP",
          "desc": "Keyboard backlight up",
          "_verb": "exec",
          "_param": "brightnessctl --device='asus::kbd_backlight' set 1+",
          "_mods": "",
          "_mainKey": "XF86KBDBRIGHTNESSUP"
        },
        {
          "keys": "XF86KBDBRIGHTNESSDOWN",
          "desc": "Keyboard backlight down",
          "_verb": "exec",
          "_param": "brightnessctl --device='asus::kbd_backlight' set 1-",
          "_mods": "",
          "_mainKey": "XF86KBDBRIGHTNESSDOWN"
        },
        {
          "keys": "XF86LAUNCH4",
          "desc": "Cycle power profile",
          "_verb": "exec",
          "_param": "$ipc powerProfile cycle",
          "_mods": "",
          "_mainKey": "XF86LAUNCH4"
        },
        {
          "keys": "Next",
          "desc": "Next track",
          "_verb": "exec",
          "_param": "playerctl next",
          "_mods": "",
          "_mainKey": "XF86AUDIONEXT"
        },
        {
          "keys": "Pause",
          "desc": "Play/pause",
          "_verb": "exec",
          "_param": "playerctl play-pause",
          "_mods": "",
          "_mainKey": "XF86AUDIOPAUSE"
        },
        {
          "keys": "Play",
          "desc": "Play/pause",
          "_verb": "exec",
          "_param": "playerctl play-pause",
          "_mods": "",
          "_mainKey": "XF86AUDIOPLAY"
        },
        {
          "keys": "Prev",
          "desc": "Previous track",
          "_verb": "exec",
          "_param": "playerctl previous",
          "_mods": "",
          "_mainKey": "XF86AUDIOPREV"
        },
        {
          "keys": "SWITCH:ON:LID SWITCH",
          "desc": "Lid switch on: lock screen",
          "_verb": "exec",
          "_param": "$ipc lockScreen lock",
          "_mods": "",
          "_mainKey": "SWITCH:ON:LID SWITCH"
        },
        {
          "keys": "SWITCH:OFF:LID SWITCH",
          "desc": "Lid switch off: lock and suspend",
          "_verb": "exec",
          "_param": "$ipc lockScreen lockAndSuspend",
          "_mods": "",
          "_mainKey": "SWITCH:OFF:LID SWITCH"
        }
      ]
    }
  ],
  "detectedCompositor": "hyprland",
  "windowWidth": 1400,
  "windowHeight": 850,
  "autoHeight": true,
  "columnCount": 3,
  "modKeyVariable": "$mod",
  "hyprlandConfigPath": "/etc/nixos/config/hyprland/extra.conf",
  "hyprlandLuaConfigPath": "/etc/nixos/config/hyprland/hyprland.lua",
  "hyprlandParserMode": "auto",
  "niriConfigPath": "~/.config/niri/config.kdl",
  "mangoConfigPath": "~/.config/mango/config.conf",
  "mergeSequentialBinds": true,
  "showUndescribedBinds": true,
  "splitLargeWorkspaceCategory": true,
  "workspaceSplitThreshold": 12,
  "keyColorAlt": "#FF6B6B",
  "keyColorXF86": "#4ECDC4",
  "keyColorPrint": "#95E1D3",
  "keyColorNumeric": "#A8DADC",
  "keyColorMouse": "#F38181",
